    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst now = new Date();\nconst dateStr = now.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});\nconst timeStr = now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true});\nconst subject = `⚠️ [NWAY ERP] Data Quality WARNING — ${dateStr}`;\nconst html = `<!DOCTYPE html><html><head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0;padding:0;background:#0f172a;font-family:'Segoe UI',Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0f172a;padding:32px 0;\"><tr><td align=\"center\">\n<table width=\"620\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#1e293b;border-radius:12px;overflow:hidden;border:1px solid #334155;\">\n<tr><td style=\"background:linear-gradient(135deg,#991b1b,#a51d24);padding:28px 32px;\">\n<table width=\"100%\"><tr>\n<td><div style=\"font-size:11px;color:rgba(255,255,255,0.7);letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;\">NWAY Technologies · AI Pipeline Monitor</div>\n<div style=\"font-size:22px;font-weight:700;color:#fff;\">⚠️ Data Quality Alert</div>\n<div style=\"font-size:13px;color:rgba(255,255,255,0.8);margin-top:4px;\">Pipeline run flagged — manual review required</div></td>\n<td align=\"right\"><div style=\"background:rgba(255,255,255,0.15);border-radius:8px;padding:10px 14px;text-align:center;\">\n<div style=\"font-size:10px;color:rgba(255,255,255,0.7);letter-spacing:1px;\">STATUS</div>\n<div style=\"font-size:18px;font-weight:800;color:#fbbf24;\">⚠ WARN</div></div></td>\n</tr></table></td></tr>\n<tr><td style=\"background:#451a03;border-left:4px solid #f59e0b;padding:16px 32px;\">\n<div style=\"font-size:13px;color:#fcd34d;\">🚨 <strong>${d.rows_dropped} rows dropped</strong> — exceeds threshold of ${d.threshold_used}. Forecast accuracy may be affected.</div></td></tr>\n<tr><td style=\"padding:28px 32px;\">\n<table width=\"100%\"><tr>\n<td width=\"33%\" style=\"padding:0 6px 0 0;\"><div style=\"background:#0f172a;border-radius:8px;padding:16px;border:1px solid #1e3a5f;text-align:center;\"><div style=\"font-size:26px;font-weight:800;color:#60a5fa;\">${d.rows_in_raw}</div><div style=\"font-size:10px;color:#64748b;margin-top:4px;letter-spacing:1px;\">ROWS IN</div></div></td>\n<td width=\"33%\" style=\"padding:0 6px;\"><div style=\"background:#0f172a;border-radius:8px;padding:16px;border:1px solid #7c2d12;text-align:center;\"><div style=\"font-size:26px;font-weight:800;color:#fb923c;\">${d.rows_dropped}</div><div style=\"font-size:10px;color:#64748b;margin-top:4px;letter-spacing:1px;\">DROPPED</div></div></td>\n<td width=\"33%\" style=\"padding:0 0 0 6px;\"><div style=\"background:#0f172a;border-radius:8px;padding:16px;border:1px solid #1e3a5f;text-align:center;\"><div style=\"font-size:26px;font-weight:800;color:#34d399;\">${d.rows_out}</div><div style=\"font-size:10px;color:#64748b;margin-top:4px;letter-spacing:1px;\">ROWS OUT</div></div></td>\n</tr></table></td></tr>\n<tr><td style=\"background:#0f172a;padding:16px 32px;border-top:1px solid #1e293b;\">\n<table width=\"100%\"><tr>\n<td><div style=\"font-size:11px;color:#475569;\">NWAY ERP · n8n Automation Pipeline</div></td>\n<td align=\"right\"><div style=\"font-size:11px;color:#475569;\">${dateStr} · ${timeStr}</div></td>\n</tr></table></td></tr>\n</table></td></tr></table></body></html>`;\nreturn [{ json: { subject, html, email_type: 'WARNING', data: d } }];"
      },
