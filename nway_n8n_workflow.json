    {
      "parameters": {
        "jsCode": "const inp = $input.first().json;\nconst d = inp.data || inp;\nconst auditEntry = {\n  pipeline: 'NWAY ERP Demand Forecasting',\n  run_id: `RUN_${Date.now()}`,\n  timestamp: new Date().toISOString(),\n  status: inp.email_type || 'COMPLETE',\n  skus_processed: d.total_skus,\n  rows_in: d.rows_in_raw,\n  rows_out: d.rows_out,\n  rows_dropped: d.rows_dropped,\n  data_quality_flag: d.flag_data_quality || false,\n  dt_mae: d.dt_mae,\n  dt_r2: d.dt_r2\n};\nconsole.log('AUDIT LOG:', JSON.stringify(auditEntry, null, 2));\nreturn [{ json: auditEntry }];"
      },
      "id": "node-audit",
      "name": "Write Audit Log Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 300]
    }
  ],
  "connections": {
