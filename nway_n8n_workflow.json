    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst logRaw = fs.readFileSync('C:\\\\Nway-Project\\\\pipeline_log.json', 'utf-8');\nconst log = JSON.parse(logRaw);\nconst THRESHOLD = 0;\nconst rowsDropped = 5;\nconst flagDrop = rowsDropped > THRESHOLD;\nconsole.log(`Pipeline Log loaded. MAE=${log.dt_mae} R2=${log.dt_r2}`);\nconsole.log(`Threshold check — dropped:${rowsDropped} flag:${flagDrop}`);\nreturn [{ json: {\n  ...log,\n  rows_dropped: rowsDropped,\n  rows_in_raw: 1800,\n  rows_out: 1795,\n  total_skus: 10,\n  flag_data_quality: flagDrop,\n  threshold_used: THRESHOLD\n} }];"
      },
