      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst now = new Date();\nconst dateStr = now.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});\nconst timeStr = now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true});\nconst subject = `✅ [NWAY ERP] Demand Forecast Ready — ${dateStr}`;\nconst dtMae = d.dt_mae || 'N/A';\nconst dtR2 = d.dt_r2 || 'N/A';\nconst html = `<!DOCTYPE html><html><head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0;padding:0;background:#0f172a;font-family:'Segoe UI',Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0f172a;padding:32px 0;\"><tr><td align=\"center\">\n<table width=\"660\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#1e293b;border-radius:12px;overflow:hidden;border:1px solid #334155;\">\n<tr><td style=\"background:linear-gradient(135deg,#991b1b,#a51d24,#7f1d1d);padding:28px 32px;\">\n<table width=\"100%\"><tr>\n<td><div style=\"font-size:10px;color:rgba(255,255,255,0.65);letter-spacing:3px;text-transform:uppercase;margin-bottom:6px;\">NWAY Technologies Pvt. Ltd. · ERP AI Automation</div>\n<div style=\"font-size:24px;font-weight:800;color:#fff;\">Inventory Demand Forecast</div>\n<div style=\"font-size:13px;color:rgba(255,255,255,0.75);margin-top:5px;\">ML Pipeline · Daily Run · ${dateStr}</div></td>\n<td align=\"right\" style=\"vertical-align:top;\"><div style=\"background:rgba(255,255,255,0.12);border-radius:10px;padding:12px 18px;text-align:center;border:1px solid rgba(255,255,255,0.2);\">\n<div style=\"font-size:9px;color:rgba(255,255,255,0.6);letter-spacing:2px;text-transform:uppercase;\">STATUS</div>\n<div style=\"font-size:20px;font-weight:800;color:#4ade80;margin:4px 0;\">✓ SUCCESS</div>\n<div style=\"font-size:10px;color:rgba(255,255,255,0.6);\">${timeStr} IST</div></div></td>\n</tr></table></td></tr>\n<tr><td style=\"padding:24px 32px 0;\">\n<div style=\"font-size:10px;color:#475569;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:14px;\">Pipeline Run Summary</div>\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr>\n<td width=\"25%\" style=\"padding:0 6px 0 0;\"><div style=\"background:#0f172a;border-radius:8px;padding:14px;border:1px solid #1e3a5f;text-align:center;\"><div style=\"font-size:22px;font-weight:800;color:#60a5fa;\">${d.rows_in_raw}</div><div style=\"font-size:9px;color:#475569;margin-top:3px;\">RECORDS IN</div></div></td>\n<td width=\"25%\" style=\"padding:0 6px;\"><div style=\"background:#0f172a;border-radius:8px;padding:14px;border:1px solid #1e3a5f;text-align:center;\"><div style=\"font-size:22px;font-weight:800;color:#34d399;\">${d.rows_out}</div><div style=\"font-size:9px;color:#475569;margin-top:3px;\">CLEANED</div></div></td>\n<td width=\"25%\" style=\"padding:0 6px;\"><div style=\"background:#0f172a;border-radius:8px;padding:14px;border:1px solid #1e293b;text-align:center;\"><div style=\"font-size:22px;font-weight:800;color:#94a3b8;\">${d.rows_dropped}</div><div style=\"font-size:9px;color:#475569;margin-top:3px;\">DROPPED</div></div></td>\n<td width=\"25%\" style=\"padding:0 0 0 6px;\"><div style=\"background:#0f172a;border-radius:8px;padding:14px;border:1px solid #1e3a5f;text-align:center;\"><div style=\"font-size:22px;font-weight:800;color:#a78bfa;\">${d.total_skus}</div><div style=\"font-size:9px;color:#475569;margin-top:3px;\">SKUs</div></div></td>\n</tr></table></td></tr>\n<tr><td style=\"padding:24px 32px;\">\n<div style=\"font-size:10px;color:#475569;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:14px;\">ML Model Performance (Decision Tree)</div>\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"border:1px solid #334155;border-radius:8px;overflow:hidden;\">\n<tr style=\"background:#0f172a;\"><th style=\"padding:10px 16px;text-align:left;font-size:10px;color:#475569;font-weight:600;\">Model</th><th style=\"padding:10px 16px;text-align:center;font-size:10px;color:#475569;font-weight:600;\">MAE ↓</th><th style=\"padding:10px 16px;text-align:center;font-size:10px;color:#475569;font-weight:600;\">R² Score ↑</th><th style=\"padding:10px 16px;text-align:center;font-size:10px;color:#475569;font-weight:600;\">Result</th></tr>\n<tr style=\"background:#162032;\"><td style=\"padding:14px 16px;border-top:1px solid #334155;\"><div style=\"font-size:13px;font-weight:700;color:#e2e8f0;\">Decision Tree (GridSearchCV)</div><div style=\"font-size:10px;color:#475569;margin-top:2px;\">5-Fold Cross Validation · Seasonal Features</div></td>\n<td style=\"padding:14px 16px;text-align:center;border-top:1px solid #334155;\"><span style=\"font-size:18px;font-weight:800;color:#4ade80;\">${dtMae}</span></td>\n<td style=\"padding:14px 16px;text-align:center;border-top:1px solid #334155;\"><span style=\"font-size:18px;font-weight:800;color:#4ade80;\">${dtR2}</span></td>\n<td style=\"padding:14px 16px;text-align:center;border-top:1px solid #334155;\"><span style=\"background:#14532d;color:#4ade80;font-size:10px;padding:4px 10px;border-radius:4px;\">✓ COMPLETE</span></td></tr>\n</table></td></tr>\n<tr><td style=\"background:#0f172a;padding:18px 32px;border-top:1px solid #1e293b;\">\n<table width=\"100%\"><tr>\n<td><div style=\"font-size:11px;color:#334155;\">NWAY Technologies Pvt. Ltd. · n8n ML Pipeline v2.0</div></td>\n<td align=\"right\"><div style=\"font-size:11px;color:#334155;\">${dateStr} · ${timeStr} IST</div></td>\n</tr></table></td></tr>\n</table></td></tr></table></body></html>`;\nreturn [{ json: { subject, html, email_type: 'SUCCESS', data: d } }];"
